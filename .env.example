# Apify Credentials & Actor Configuration
APIFY_TOKEN=
APIFY_REEL_ACTOR_ID=apify/instagram-reel-scraper
APIFY_DISCOVERY_ACTOR_ID=apify/instagram-hashtag-scraper

# Database & Logging
DATABASE_PATH=./data/reel-radar.sqlite
LOG_LEVEL=info

# Collection & Scoring Defaults
MAX_CONCURRENT_JOBS=2
DEFAULT_RESULTS_PER_PROFILE=20
DEFAULT_LOOKBACK_DAYS=30
MIN_VIDEOS_FOR_BASELINE=5
BASELINE_FLOOR_VIEWS=500
RECENCY_HALF_LIFE_DAYS=14
CACHE_TTL_MINUTES=60

# Competitor Discovery Limits & Cost Controls
MAX_DISCOVERY_DEPTH=1
MAX_NEW_ACCOUNTS_PER_RUN=10
MAX_TOTAL_ACCOUNTS_PER_NICHE=50
MAX_DAILY_ESTIMATED_SPEND_USD=5.00
AUTO_APPROVE_CANDIDATES=false

# AI Analysis & Optional Transcription (Optional)
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
TRANSCRIPT_PROVIDER=none

# Server Configuration
PORT=3000
HOST=127.0.0.1
